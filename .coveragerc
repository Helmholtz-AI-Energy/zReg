# .coveragerc to control coverage.py
[run]
branch = True
source = zreg
omit =
    # Typing protocol with no runtime code (only contains ellipsis)
    */distances/_protocol.py
    # Test files — measured as test infrastructure, not coverage targets
    tests/*
    # Utility/entry-point scripts with no unit-testable logic
    setup.py
    create_comparison_pdf.py
    benchmark_label_transfer.py
    # Torch-geometric JIT-compiled temp files
    /private/var/folders/*
    /tmp/*

[paths]
source =
    src/
    */site-packages/

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__
    if self\.debug

    # Don't complain if tests don't hit defensive assertion code:
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run:
    if 0:
    if __name__ == .__main__.:
