   "source": [
    "# CPD testing\n",
    "# import torch_cluster as tcl\n",
    "target = copy.deepcopy(pcs3[140])  # shah  (max ~420)\n",
    "source = copy.deepcopy(pcs[210])  # kobitzky (max ~360)\n",
    "# target['pos'], _ = zreg.utils.normalize_point_cloud(target['pos'])\n",
    "# # source['pos'], _ = zreg.utils.normalize_point_cloud(source['pos'])\n",
    "zreg.downsampling.remove_outliers_knn(target, inplace=True)\n",
    "zreg.downsampling.remove_outliers_knn(source, inplace=True)\n",
    "\n",
    "# target, source = zreg.downsampling.random_down_sample(target, source)\n",
    "source[\"pos\"], _ = zreg.utils.normalize_point_cloud(source[\"pos\"])\n",
    "target[\"pos\"], _ = zreg.utils.normalize_point_cloud(target[\"pos\"])\n",
    "source[\"pos\"], target[\"pos\"], _ = zreg.utils.normalize_to_pc_w_most_points(source[\"pos\"], target[\"pos\"])\n",
    "\n",
    "pc1new = target.get_open3d_pc()  # shah\n",
    "pc0new = source.get_open3d_pc()\n",
    "draw_registration_result(pc1new)"
   ]
